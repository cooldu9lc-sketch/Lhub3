class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        rows, cols = len(s), len(p)
        
        # Create a 2D DP table initialized to False
        dp = [[False] * (cols + 1) for _ in range(rows + 1)]
        
        # Empty string matches empty pattern
        dp[0][0] = True
        
        # Initialize the first row (Empty string 's' matching with pattern 'p')
        # A pattern like "a*b*c*" can match an empty string
        for j in range(2, cols + 1):
            if p[j - 1] == '*':
                # If we see a '*', we look at the result 2 steps back 
                # (acting as if the char + '*' combination never existed)
                dp[0][j] = dp[0][j - 2]
                
        # Fill the DP table
        for i in range(1, rows + 1):
            for j in range(1, cols + 1):
                
                # Case 1: Current characters match, or pattern has a '.'
                if p[j - 1] == s[i - 1] or p[j - 1] == '.':
                    dp[i][j] = dp[i - 1][j - 1]
                    
                # Case 2: Pattern has a '*'
                elif p[j - 1] == '*':
                    # Option A: Zero occurrences of the preceding character
                    # We just drop the "char*" combo (look 2 columns back)
                    dp[i][j] = dp[i][j - 2]
                    
                    # Option B: One or more occurrences
                    # We check if the preceding character matches the current string character
                    if p[j - 2] == s[i - 1] or p[j - 2] == '.':
                        # If it matches, we look up one row (meaning we successfully consumed a character in s)
                        dp[i][j] = dp[i][j] or dp[i - 1][j]
                        
        # The answer is whether the full string matches the full pattern
        return dp[rows][cols]
